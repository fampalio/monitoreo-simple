# /etc/monitoreo/push.env — en cada servidor (root:root 644). Sin secretos.
# Lo lee metrics-push.sh.

# Nombre corto del central, tal como lo devuelve `hostname -s` en el central.
# En el central el push es local; en los demás, por SSH.
CENTRAL_NAME=REEMPLAZAR_NOMBRE_CENTRAL

# Cómo llegar al central por SSH desde los demás (IP o nombre) y su puerto.
CENTRAL_ADDR=REEMPLAZAR_IP_O_NOMBRE_CENTRAL
CENTRAL_PORT=22
