# /etc/monitoreo/dms.env — sólo en el vigía (root:root 600). El valor real
# del token NO va a ningún repo.
#
# URL pública de tu n8n (sin barra al final).
N8N_URL=https://REEMPLAZAR_DOMINIO_N8N

# A quién le llegan los avisos por correo.
DEST=REEMPLAZAR_CORREO

# Mismo valor que la credencial "Header Auth" del workflow latido-monitoreo
# en n8n (cabecera X-Latido-Token). Generarlo con: openssl rand -hex 32
LATIDO_TOKEN=REEMPLAZAR_TOKEN_LATIDO
